.build/
.DS_Store
*.xcodeproj
*.xcworkspace

# 사전 원본은 용량이 커서 받아 쓴다 (Tools/fetch-jmdict.sh)
Tools/data/JMdict_e
Tools/data/JMdict_e.gz
# JPDB 빈도 목록. 재배포 조건이 불분명해 저장소에 넣지 않는다
Tools/data/jpdb_freq.csv

# 예문 코퍼스도 받아 쓴다 (Tools/fetch-tanaka.sh)
Tools/data/examples.utf
Tools/data/examples.utf.gz

# 자막 코퍼스와 거기서 만든 빈도 목록 (Tools/fetch-jesc.sh)
Tools/data/jesc-split.tar.gz
Tools/data/split/
Tools/data/jesc_freq*.tsv

# 구운 사전 색인 (Tools/build-index.sh)
Tools/data/mworago-dict.db

# xcodegen 이 만드는 것들 (project.yml 만 관리한다)
Mworago.xcodeproj/
.build-ios/

# 앱 번들에 넣는 자료는 Tools 에서 구워 복사한다 (Tools/setup-app-resources.sh)
MworagoApp/Resources/*.db
MworagoApp/Resources/*.tsv

# 모델로 구운 한국어 뜻 (swift run Translator)
Tools/data/korean-gloss.tsv
# 굽는 동안 남는 것들 — 모델이 낸 날것, 정리본, 사람이 정해야 하는 목록
Tools/data/korean-gloss-exaone*.tsv
Tools/data/korean-gloss.clean.tsv
Tools/data/korean-gloss.redo.tsv

# 폰트는 Google Fonts(OFL)에서 받는다 (Tools/fetch-fonts.sh)
MworagoApp/Resources/Fonts/
MworagoApp/Resources/hanja-reading.tsv
Tools/data/*.log

# Xcode 개인 설정 — 사람마다 다르고 공유할 것이 없다
xcuserdata/
*.xcuserdatad
